{
  "name": "sealedev",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:db": "vitest run tests/db",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "db:push": "npx supabase db push",
    "db:reset": "npx supabase db reset",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/run-sql.mts seed",
    "catalog:import": "tsx --env-file-if-exists=.env.local scripts/import-catalog.mts",
    "prices:refresh": "tsx --env-file-if-exists=.env.local scripts/refresh-prices.mts",
    "user:make-admin": "tsx --env-file-if-exists=.env.local scripts/make-admin.mts",
    "db:setup": "tsx --env-file-if-exists=.env.local scripts/run-sql.mts setup",
    "prices:refresh:force": "tsx --env-file-if-exists=.env.local scripts/refresh-prices.mts --force",
    "setup": "tsx scripts/setup.mts",
    "catalog:sync": "tsx --env-file-if-exists=.env.local scripts/catalog-sync.mts",
    "catalog:sync:all": "tsx --env-file-if-exists=.env.local scripts/catalog-sync.mts all 0",
    "tcgtracking:check": "tsx scripts/tcgtracking-check.mts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "papaparse": "^5.7.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.9"
  }
}
