# Copy to .env.local for local development. Never commit real values.

# --- Public (embedded in the browser bundle; safe to expose) -----------------
# Supabase project URL and publishable/anon key (Project Settings → API).
# These are public by design: Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Canonical site URL, used in auth emails and OAuth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to 1 after enabling the Google provider in Supabase Auth.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=0

# --- Server-only secrets (NEVER prefix with NEXT_PUBLIC_) ---------------------
# Supabase service-role / secret key. Bypasses RLS: used only by the scheduled
# refresh, catalog import, CLI scripts and account deletion.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
# Shared secret for /api/cron/refresh-prices (Vercel Cron sends it as a Bearer token).
CRON_SECRET=generate-a-long-random-string

# --- Pricing providers (optional) -------------------------------------------
# TCGCSV needs no key. Set to 0 to disable it.
ENABLE_TCGCSV=1
# Pokémon TCG API: optional secondary card source. A free key raises rate limits.
ENABLE_POKEMONTCG=0
POKEMONTCG_API_KEY=
# Skip scheduled refreshes that run sooner than this after the last success.
PRICE_REFRESH_MIN_INTERVAL_HOURS=12

# --- CLI only ---------------------------------------------------------------
# Direct Postgres connection string, used by `npm run db:seed` (psql).
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
